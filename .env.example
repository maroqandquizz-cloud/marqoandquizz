# Vercel → Project → Settings → Environment Variables (Production va Preview)
ADMIN_PASSWORD=bu-yerga-kuchli-parol-yozing      # saytga kirish paroli (siz o'zingiz o'ylab topasiz)
# Quyidagilarni Vercel Storage bo'limidagi integratsiyalar o'zi qo'shadi:
KV_REST_API_URL=                                  # Upstash Redis
KV_REST_API_TOKEN=                                # Upstash Redis
BLOB_READ_WRITE_TOKEN=                            # Vercel Blob (PUBLIC store)
